VERSION 16.0 
POSITION . . 570 545


// --------------------
// TAB 0: Placeholder
// --------------------


DIALOG placeholder, label("ARCED Data Flow") tabtitle("intro")
BEGIN
GROUPBOX gb_header 70 10 430 95, label("About") // Adjusted x-coordinate for centering
	TEXT tx_title 80 25 410 ., label("ARCED DATAFLOW AND FOLDER SETUP") center
	TEXT tx_line1 80 45 410 ., label("Use this tool to create the project folder, install, and run arceddataflow") center
	BUTTON bt_rehub 120 70 120 20, label("ARCED Rehub") onpush(view "browse https://rehub.arced.foundation/login/") 
	BUTTON bt_website 320 70 120 20, label("ARCED Foundation") onpush(view "browse https://arced.foundation/")

		
GROUPBOX gb_installations 70 110 430 110, label("Installations") // Adjusted x-coordinate for centering
	TEXT gb_text1 150 125 120 60, label("Select One")
	TEXT gb_text2 350 125 120 60, label("More Info")
	LISTBOX cb_arcedfold_on 120 145 120 60, contents(commandlist) values(commandvalues) onselchange(program select_change)  // ondblclick(arcedfold_off)
	BUTTON bt_fold 320 145 120 20, label("ARCED Fold") onpush(view "browse https://github.com/ARCED-Foundation/arcedfold")
	BUTTON bt_subfold 320 165 120 20, label("ARCED Subfold") onpush(view "browse https://github.com/ARCED-Foundation/arcedfold") 
	BUTTON bt_dataflow 320 185 120 20, label("ARCED Dataflow") onpush(view "browse https://github.com/ARCED-Foundation/arceddataflow")


GROUPBOX gb_information 70 225 430 285, label("Information") // Adjusted x-coordinate for centering and height

	
	TEXT tx_info_arcedfold_title 80 240 410 ., label("ARCED Fold:") // Updated label
	TEXT tx_info_arcedfold_desc1 80 260 410 ., label("arcedfold is a stata command that creates ARCED project folders. It can be")
	TEXT tx_info_arcedfold_desc2 80 280 410 ., label("used to start or archive a project.")
	TEXT tx_info_arcedsubfold_title 80 310 410 ., label("ARCED Subfold:")
	TEXT tx_info_arcedsubfold_desc1 80 330 410 ., label("arcedsubfold creates new folders in an existing folder structure. The folder ")
	TEXT tx_info_arcedsubfold_desc2 80 350 410 ., label("structure must have the same structure as generated by arcedfold.")
	TEXT tx_info_dataflow_title 80 380 410 ., label("ARCED Dataflow:")
	TEXT tx_info_dataflow_desc 80 400 410 ., label("arceddataflow generates project data flow do-files.")
	TEXT tx_info_arcedfold_version_title 80 430 410 ., label("Current version:")
	TEXT tx_info_arcedfold_v3 80 450 406 ., label("V4: August 2025")
	TEXT tx_info_arcedfold_author 80 470 406 ., label("Author: Mehrab Ali, ARCED Foundation")

	

END


LIST commandlist 
	BEGIN 
		arcedfold
		arcedsubfold
		arceddataflow
	END
	
LIST commandvalues
	BEGIN
		1
		2
		3
	END
	
PROGRAM select_change
	BEGIN		
		if placeholder.cb_arcedfold_on.isNumlistEQ(1){
			//enable from tab 1

			call fold.ed_proj1.enable
			call fold.ed_path1.enable
			call fold.ed_rounds1.enable
			call fold.ed_surv1.enable
			call fold.ed_auth1.enable
			call fold.ed_email1.enable

			// disable from tab 2
			call subfold.ed_proj2.disable
			call subfold.ed_path2.disable
			call subfold.ed_rounds2.disable
			call subfold.ed_surv2.disable
			call subfold.ed_auth2.disable
			call subfold.ed_email2.disable
			
			
			// disable from tab 3
			call main.ed_do.disable
			call main.ed_corr.disable
			call main.ed_auth.disable
			call main.ed_email.disable
			call main.ed_proj.disable
		}
		
		if placeholder.cb_arcedfold_on.isNumlistEQ(2){
			
			//disable from tab 1
			call fold.ed_proj1.disable
			call fold.ed_path1.disable
			call fold.ed_rounds1.disable
			call fold.ed_surv1.disable
			call fold.ed_auth1.disable
			call fold.ed_email1.disable
			
			//enable tab 2
			call subfold.ed_proj2.enable
			call subfold.ed_path2.enable
			call subfold.ed_rounds2.enable
			call subfold.ed_surv2.enable
			call subfold.ed_auth2.enable
			call subfold.ed_email2.enable
		
			// disable from tab 3
			call main.ed_do.disable
			call main.ed_corr.disable
			call main.ed_auth.disable
			call main.ed_email.disable
			call main.ed_proj.disable

		}
		
		if placeholder.cb_arcedfold_on.isNumlistEQ(3){
			//disable from tab 1
			call fold.ed_proj1.disable
			call fold.ed_path1.disable
			call fold.ed_rounds1.disable
			call fold.ed_surv1.disable
			call fold.ed_auth1.disable
			call fold.ed_email1.disable
			
			// disable from tab 2
			call subfold.ed_proj2.disable
			call subfold.ed_path2.disable
			call subfold.ed_rounds2.disable
			call subfold.ed_surv2.disable
			call subfold.ed_auth2.disable
			call subfold.ed_email2.disable
			
			//enable from tab 3
			call main.ed_do.enable
			call main.ed_corr.enable
			call main.ed_auth.enable
			call main.ed_email.enable
			call main.ed_proj.enable
		}
	END

	
// --------------------
// TAB 1: ARCED FOLD
// --------------------


DIALOG fold, label("ARCED Fold") tabtitle("arcedfold")
BEGIN
    // First groupbox (About) - Added to fold tab
GROUPBOX gb_header 70 10 430 95, label("About")
     TEXT tx_title 80 25 410 ., label("ARCED FOLDER SETUP") center
     TEXT tx_line1 80 45 410 ., label("Use this tool to create the project folder for arceddataflow") center
     BUTTON bt_rehub 120 70 120 20, label("ARCED Rehub") onpush(view "browse https://rehub.arced.foundation/login/") 
	 BUTTON bt_website 320 70 120 20, label("ARCED Foundation") onpush(view "browse https://arced.foundation/")
   
   
   // Second groupbox (Project Details) - positioned below gb_header
	GROUPBOX gb_fold_content 70 125 430 405, label("ARCED Fold Details") // Adjusted Y-position to be below gb_header + gap
    TEXT   tx_proj1    85 150 400 ., label("Enter your Project name") // Adjusted Y-position relative to dialog
    EDIT   ed_proj1    85 +20 400 ., error("Project name must be filled") tooltip("Enter the project name")
    TEXT   tx_path1    85 +40 400 ., label("Enter Project Path")
    FILE   ed_path1    85 +20 400 ., directory label("Browse") tooltip("Browse for Project folder")
    TEXT   tx_rounds1  85 +40 400 ., label("Enter Rounds")
    EDIT   ed_rounds1  85 +20 400 ., error("Rounds must be filled") tooltip("Enter the number of rounds")
    TEXT   tx_surv1    85 +40 400 ., label("Enter Survey Name")
    EDIT   ed_surv1    85 +20 400 ., error("Survey name must be filled") tooltip("Enter the survey name")
    TEXT   tx_auth1    85 +40 400 ., label("Author")
    EDIT   ed_auth1    85 +20 400 ., error("Author name must be filled") tooltip("Enter the author name")
    TEXT   tx_email1   85 +40 400 ., label("Email")
    EDIT   ed_email1   85 +20 400 ., error("Email must be filled") default("@arced.foundation") tooltip("Enter your email address")
    //BUTTON helpbtn      80 +60 100 ., label("Help") onpush(view `"browse https://arced-foundation.github.io/"')
END

// --------------------
// TAB 2: ARCED Subfold
// --------------------

DIALOG subfold, label("ARCED Subfold") tabtitle("arcedsubfold")
BEGIN
    // First groupbox (About) - Added to subfold tab
	GROUPBOX gb_header 70 10 430 95, label("About")
    TEXT tx_title 80 25 410 ., label("ARCED SUBFOLDER SETUP") center
    TEXT tx_line1 80 45 410 ., label("Use this tool to create the project sub folder for arceddataflow") center
	BUTTON bt_rehub 120 70 120 20, label("ARCED Rehub") onpush(view "browse https://rehub.arced.foundation/login/") 
	BUTTON bt_website 320 70 120 20, label("ARCED Foundation") onpush(view "browse https://arced.foundation/")
   
   
	GROUPBOX gb_subfold_content 70 125 430 405, label("ARCED Subfold Details") // Adjusted Y-position to be below gb_header + gap
    TEXT   tx_proj2    85 150 400 ., label("Enter your Project name") // Adjusted Y-position relative to dialog
    EDIT   ed_proj2    85 +20 400 ., error("Project name must be filled") tooltip("Enter the project name")
    TEXT   tx_path2    85 +40 400 ., label("Enter Project Path")
    FILE   ed_path2    85 +20 400 ., directory label("Browse") tooltip("Browse for Project folder")
    TEXT   tx_rounds2  85 +40 400 ., label("Enter Rounds")
    EDIT   ed_rounds2  85 +20 400 ., error("Rounds must be filled") tooltip("Enter the number of rounds")
    TEXT   tx_surv2    85 +40 400 ., label("Enter Survey Name")
    EDIT   ed_surv2    85 +20 400 ., error("Survey name must be filled") tooltip("Enter the survey name")
    TEXT   tx_auth2    85 +40 400 ., label("Author")
    EDIT   ed_auth2    85 +20 400 ., error("Author name must be filled") tooltip("Enter the author name")
    TEXT   tx_email2   85 +40 400 ., label("Email")
    EDIT   ed_email2   85 +20 400 ., error("Email must be filled") default("@arced.foundation") tooltip("Enter your email address")
    //BUTTON helpbtn      80 +60 100 ., label("Help") onpush(view `"browse https://arced-foundation.github.io/"')
END



// --------------------
// TAB 3: ARCED Dataflow
// --------------------

DIALOG main, label("ARCED Dataflow") tabtitle("arceddataflow")
BEGIN
    // First groupbox (About)
GROUPBOX gb_header 70 10 430 95, label("About")
     TEXT tx_title 80 25 410 ., label("ARCED DATAFLOW SETUP") center
     TEXT tx_line1 80 45 410 ., label("Use this tool to run arceddataflow") center
     BUTTON bt_rehub 120 70 120 20, label("ARCED Rehub") onpush(view "browse https://rehub.arced.foundation/login/") 
	 BUTTON bt_website 320 70 120 20, label("ARCED Foundation") onpush(view "browse https://arced.foundation/")
    
	// Second groupbox (Project Details) - positioned below gb_header
GROUPBOX gb_main_content 70 125 430 330, label("Project Details") // Adjusted Y-position to be below gb_header + gap
    TEXT   tx_do       85 150 400 ., label("Enter Do file folder path") // Adjusted Y-position for spacing
    FILE   ed_do       85 +20 400 ., directory label("Browse") tooltip("Select the do file folder")
    TEXT   tx_corr     85 +40 400 ., label("Enter Correction folder path")
    FILE   ed_corr     85 +20 400 ., directory label("Browse") tooltip("Browse for Correction folder")
    TEXT   tx_auth     85 +40 400 ., label("Enter your/ Author name")
    EDIT   ed_auth     85 +20 400 ., error("Author name must be filled") tooltip("Enter the author name")
    TEXT   tx_email    85 +40 400 ., label("Email")
    EDIT   ed_email    85 +20 400 ., error("Email must be filled") default("@arced.foundation") tooltip("Enter your email address")
    TEXT   tx_proj     85 +40 400 ., label("Enter your Project name")
    EDIT   ed_proj     85 +20 400 ., error("Project name must be filled") tooltip("Enter the project name")
    //BUTTON helpbtn     80 +60 100 ., label("Help") onpush(view `"browse https://arced-foundation.github.io/"')
END


OK ok1, label("Run") target(stata)
CANCEL can1, label("Cancel") target(stata hidden)
//HELP help1, label("Help") view(browse "https://github.com/ARCED-Foundation/arceddataflow")
RESET res1



// --------------------
// PROGRAM command (main logic)
// --------------------
PROGRAM command
BEGIN
   
 // ARCED Fold command construction
     if placeholder.cb_arcedfold_on.isNumlistEQ(1){
		put "arcedfold "
		require fold.ed_proj1
		put fold.ed_proj1 
		put ",path("
		require fold.ed_path1
		put `"""' fold.ed_path1 `"""'
		put ") "
		put "rounds("
		put `"""' fold.ed_rounds1 `"""'
		put ") "
		put "survey("
		put `"""' fold.ed_surv1 `"""'
		put ") "
		put "author("
		put `"""' fold.ed_auth1 `"""'
		put ") "
		put "email("
		put `"""' fold.ed_email1 `"""'
		put ")"
}
	// ARCED subfold command construction
 if placeholder.cb_arcedfold_on.isNumlistEQ(2) {
        put "arcedsubfold "
        require subfold.ed_proj2
        put subfold.ed_proj2 
        put ",path("
        require subfold.ed_path2
        put `"""' subfold.ed_path2 `"""'
        put ") "
        put "rounds("
        put `"""' subfold.ed_rounds2 `"""'
        put ") "
        put "survey("
        put `"""' subfold.ed_surv2 `"""'
        put ") "
        put "author("
        put `"""' subfold.ed_auth2 `"""'
        put ") "
        put "email("
        put `"""' subfold.ed_email2 `"""'
        put ")"
    }
	
	 // ARCED Dataflow command construction
    if placeholder.cb_arcedfold_on.isNumlistEQ(3) {
        put "arceddataflow, do("
        require main.ed_do
        put `"""' main.ed_do `"""'
        put ") "
        put "correction("
        require main.ed_corr
        put `"""' main.ed_corr `"""'
        put ") "
        put "author("
        require main.ed_auth
        put `"""' main.ed_auth `"""'
        put ") "
        put "email("
        require main.ed_email
        put `"""' main.ed_email `"""'
        put ") "
        put "project("
        require main.ed_proj
        put `"""' main.ed_proj `"""'
        put ")"
    }

END

